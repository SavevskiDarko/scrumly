{
  "name": "scrumly",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A Scrum Master's working surface. Single user, local-first, no server.",
  "author": "Scrumly",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app": "node scripts/dev-app.mjs",
    "app:dir": "npm run build && electron-builder --dir",
    "app:build": "npm run build && electron-builder",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "tsx test/smoke.ts",
    "save": "node scripts/save-data.mjs"
  },
  "build": {
    "appId": "com.scrumly.desktop",
    "productName": "Scrumly",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@supabase/supabase-js": "^2.117.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-singlefile": "^2.0.2"
  }
}
